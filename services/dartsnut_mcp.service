[Unit]
Description=Dartsnut MCP Server
After=network.target dartsnut_matrix.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/rpi/dartsnut_rpi
ExecStart=/home/rpi/dartsnut_rpi/uv run uvicorn mcp_server.app:app --host 0.0.0.0 --port 9252
Restart=always

[Install]
WantedBy=multi-user.target

