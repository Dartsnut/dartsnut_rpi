[Unit]
Description=Dartsnut pending update repair
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/rpi/dartsnut_rpi
ExecStart=/bin/sh -c 'set -eu; found=0; for marker in /boot/firmware/dartsnut_update_pending /boot/dartsnut_update_pending /var/lib/dartsnut/update_pending; do [ -f "$$marker" ] && found=1; done; [ "$$found" = "1" ] || exit 0; python3 ./check_and_update.py && rm -f /boot/firmware/dartsnut_update_pending /boot/dartsnut_update_pending /var/lib/dartsnut/update_pending'

[Install]
WantedBy=multi-user.target
